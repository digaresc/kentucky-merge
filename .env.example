# owner/name of the hackathon repo. Leave empty for a local demo race.
TARGET_REPO=
# Read-only fine-grained token (Contents, Pull requests, Issues: Read). Strongly recommended:
# without it GitHub throttles the projector after a few minutes.
GITHUB_TOKEN=

# The race
EVENT_START=                 # ISO 8601, e.g. 2026-11-20T18:00:00-06:00 (STANDBY until set)
EVENT_MINUTES=80
EVENT_TITLE=KENTUCKY MERGE
TICKER_MESSAGE=              # e.g. 🍕 PIZZA AT 9PM · 🎸 LIVE BAND AT 10PM
TRACK_LENGTH=10
EXCLUDE_LOGINS=              # hosts/bots to hide, comma-separated

# Optional: replay reviews from a reviewer bot such as Sir Nitpicksalot
REVIEWER_LOGIN=              # the account the bot comments as
REVIEWER_TICK_URL=           # e.g. https://your-nitpicksalot.vercel.app/api/tick
